{
  "name": "lcmt-dev-mailer",
  "version": "2.10.0",
  "private": true,
  "scripts": {
    "build": "esbuild assets/src/*.js --bundle --minify --target=es2018 --outdir=assets/dist",
    "test:js": "rm -rf .cache/js-tests && esbuild tests/js/*.test.js --bundle --platform=node --format=cjs --external:esbuild --outdir=.cache/js-tests && node --test .cache/js-tests/*.js",
    "watch": "esbuild assets/src/*.js --bundle --minify --target=es2018 --outdir=assets/dist --watch"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "altcha": "3.5.0",
    "node-snackbar": "^0.1.16"
  }
}
