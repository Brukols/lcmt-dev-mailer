#: includes/form-endpoint.php
msgid "Unknown form."
msgstr "Formulaire inconnu."

#: includes/form-endpoint.php
#, php-format
msgid "The field \"%s\" is required."
msgstr "Le champ \"%s\" est obligatoire."

#: includes/form-endpoint.php
#. translators: %s: the field name
#, php-format
msgid "The field \"%s\" must be a valid email address."
msgstr "Le champ \"%s\" doit contenir une adresse email valide."

#: includes/form-endpoint.php
#. translators: %s: the field name
#, php-format
msgid "The field \"%s\" must be a number."
msgstr "Le champ \"%s\" doit contenir un nombre."

#: includes/form-endpoint.php
#. translators: %s: the field name
#, php-format
msgid "The field \"%s\" must be a valid URL."
msgstr "Le champ \"%s\" doit contenir une URL valide."

